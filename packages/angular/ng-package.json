{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/packages/angular",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "assets": [
    {
      "input": "src/styles",
      "glob": "**/*.scss",
      "output": "styles"
    },
    {
      "input": "src/lib/components/actions/button/styles",
      "glob": "_*.scss",
      "output": "styles"
    },
    {
      "input": "src/lib/components/actions/icon-button/styles",
      "glob": "_*.scss",
      "output": "styles"
    },
    {
      "input": "src/lib/components/forms/input/styles",
      "glob": "_*.scss",
      "output": "styles"
    },
    {
      "input": "src/lib/components/interaction/popover/styles",
      "glob": "_*.scss",
      "output": "styles"
    },
    {
      "input": "src/lib/components/interaction/tooltip/styles",
      "glob": "_*.scss",
      "output": "styles"
    },
    {
      "input": "src/lib/components/feedback/toast/styles",
      "glob": "_*.scss",
      "output": "styles"
    }
  ]
}
