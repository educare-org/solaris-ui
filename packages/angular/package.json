{
  "name": "@educarehq/solaris-ui",
  "version": "0.8.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/educarehq/solaris-ui.git",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "fesm2022",
    "types",
    "styles",
    "schematics",
    "README.md",
    "package.json"
  ],
  "peerDependencies": {
    "@angular-devkit/schematics": "^21.0.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "rxjs": "^7.8.0",
    "vitest": "^4.0.8"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "sideEffects": false,
  "schematics": "./schematics/collection.json",
  "exports": {
    "./styles": {
      "style": "./styles/_index.scss",
      "default": "./styles/_index.scss"
    },
    "./styles/*": {
      "style": "./styles/_*.scss",
      "default": "./styles/_*.scss"
    }
  }
}
