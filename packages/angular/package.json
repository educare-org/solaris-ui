{
  "name": "@educarehq/solaris-ui",
  "version": "2.0.6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/educarehq/solaris-ui.git",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "fesm2022",
    "types",
    "styles",
    "schematics",
    "README.md",
    "package.json"
  ],
  "peerDependencies": {
    "@angular-devkit/schematics": "^22.2.4",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "~22.2.3",
    "rxjs": "^7.8.0",
    "shiki": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  },
  "sideEffects": false,
  "schematics": "./schematics/collection.json",
  "exports": {
    "./styles": {
      "style": "./styles/_index.scss",
      "default": "./styles/_index.scss"
    },
    "./styles/*": {
      "style": "./styles/_*.scss",
      "default": "./styles/_*.scss"
    }
  },
  "dependencies": {
    "country-flag-icons": "^1.6.20",
    "libphonenumber-js": "^1.13.11"
  }
}
