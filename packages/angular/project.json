{
  "name": "angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/angular/ng-package.json",
        "tsConfig": "packages/angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "runnerConfig": true,
        "exclude": ["**/*.ssr.spec.ts"]
      }
    },
    "test:coverage": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "coverage": true,
        "coverageReporters": ["text", "lcov", "html"],
        "coverageThresholds": {
          "statements": 85,
          "branches": 85,
          "functions": 85,
          "lines": 85
        }
      }
    },
    "test:schematics": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm build:schematics",
          "vitest run --config packages/angular/vitest.schematics.config.ts"
        ],
        "parallel": false
      }
    },
    "test:ssr": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx build angular",
          "vitest run --config packages/angular/vitest.ssr.config.ts"
        ],
        "parallel": false
      }
    },
    "build:schematics": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm tsc -p packages/angular/tsconfig.schematics.json",
          "node tools/scripts/build-schematics.mjs"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "packages/angular/.storybook",
        "browserTarget": "angular:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/angular",
        "configDir": "packages/angular/.storybook",
        "browserTarget": "angular:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c packages/angular/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "angular:build-storybook",
        "staticFilePath": "dist/storybook/angular",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "angular:build-storybook:ci"
        }
      }
    }
  }
}
