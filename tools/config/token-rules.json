{
  "patterns": [
    {
      "property": "length-rem",
      "pattern": "\\d+(\\.\\d+)?rem",
      "reason": "Use px or px-based design tokens instead of rem",
      "exceptionComment": "SOLARIS_TOKEN_EXCEPTION"
    },
    {
      "property": "hex-color",
      "pattern": "#[0-9a-fA-F]{3,8}",
      "reason": "Use design tokens instead of direct hex color values",
      "exceptionComment": "SOLARIS_TOKEN_EXCEPTION"
    },
    {
      "property": "rgb/rgba",
      "pattern": "rgba?\\s*\\(",
      "reason": "Use design tokens instead of direct rgb/rgba color values",
      "exceptionComment": "SOLARIS_TOKEN_EXCEPTION"
    },
    {
      "property": "box-shadow",
      "pattern": "box-shadow\\s*:\\s*(?!\\s*var\\()",
      "reason": "Use theme token for box-shadow instead of hardcoded values",
      "exceptionComment": "SOLARIS_TOKEN_EXCEPTION"
    },
    {
      "property": "z-index",
      "pattern": "z-index\\s*:\\s*\\d+",
      "reason": "Use a z-index scale token instead of hardcoded z-index",
      "exceptionComment": "SOLARIS_TOKEN_EXCEPTION"
    }
  ]
}
