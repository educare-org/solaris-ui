{
  "name": "@solaris-ui/angular",
  "version": "0.3.2",
  "license": "MIT",
  "scripts": {
    "start": "node tools/scripts/check-workspace.mjs && node tools/scripts/check-package-manager.mjs && pnpm nx serve showcase --port=4300",
    "dev": "pnpm start",
    "showcase": "pnpm start",
    "build": "pnpm nx run-many -t build",
    "build:lib": "pnpm nx build angular && pnpm build:schematics",
    "build:schematics": "pnpm nx run angular:build:schematics",
    "build:showcase": "pnpm nx build showcase",
    "test": "pnpm nx run-many -t test",
    "lint": "pnpm nx run-many -t lint",
    "lint:scss": "stylelint \"packages/**/*.scss\" \"apps/**/*.scss\"",
    "format": "pnpm nx format:write",
    "format:check": "pnpm nx format:check",
    "graph": "pnpm nx graph",
    "doctor": "node tools/scripts/doctor.mjs",
    "check:workspace": "node tools/scripts/check-workspace.mjs",
    "check:package-manager": "node tools/scripts/check-package-manager.mjs",
    "check:scripts": "node tools/scripts/check-scripts.mjs",
    "check:architecture": "node tools/scripts/check-architecture.mjs",
    "check:docs": "node tools/scripts/check-docs.mjs",
    "check:tokens": "node tools/scripts/check-tokens.mjs",
    "check:i18n": "node tools/scripts/check-i18n.mjs",
    "check:translation": "node tools/scripts/check-translation.mjs",
    "check:security": "node tools/scripts/check-security.mjs",
    "check:dependencies": "node tools/scripts/check-dependencies.mjs",
    "check:token-references": "node tools/scripts/check-token-references.mjs",
    "check:changeset": "node tools/scripts/check-changeset.mjs",
    "check:bundle-import": "node tools/scripts/check-bundle-import.mjs",
    "check:vulnerabilities": "node tools/scripts/check-vulnerabilities.mjs",
    "check:push": "node tools/scripts/check-workspace.mjs && node tools/scripts/check-scripts.mjs && node tools/scripts/check-architecture.mjs && node tools/scripts/check-docs.mjs && node tools/scripts/check-security.mjs && node tools/scripts/check-dependencies.mjs && node tools/scripts/check-tokens.mjs && node tools/scripts/check-token-references.mjs && node tools/scripts/check-i18n.mjs && node tools/scripts/check-translation.mjs && node tools/scripts/check-changeset.mjs --base origin/develop && pnpm lint:scss && pnpm lint && pnpm typecheck && node tools/scripts/validate-component.mjs",
    "package:check": "node tools/scripts/check-package.mjs",
    "generate:component": "node tools/scripts/generate-component.mjs",
    "validate:component": "node tools/scripts/validate-component.mjs",
    "prepare": "simple-git-hooks",
    "commitlint": "commitlint",
    "check:staged": "pnpm lint-staged",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status",
    "test:watch": "pnpm nx test angular --watch",
    "test:coverage": "pnpm nx run-many -t test:coverage",
    "check": "node tools/scripts/check-workspace.mjs && node tools/scripts/check-package-manager.mjs && node tools/scripts/check-scripts.mjs && node tools/scripts/check-architecture.mjs && node tools/scripts/check-docs.mjs && node tools/scripts/check-security.mjs && node tools/scripts/check-dependencies.mjs && node tools/scripts/check-tokens.mjs && node tools/scripts/check-token-references.mjs && node tools/scripts/check-i18n.mjs && node tools/scripts/check-translation.mjs && node tools/scripts/check-changeset.mjs && node tools/scripts/check-vulnerabilities.mjs && pnpm lint:scss && pnpm lint && pnpm typecheck && node tools/scripts/validate-component.mjs",
    "typecheck": "pnpm tsc --noEmit -p packages/angular/tsconfig.lib.json && pnpm tsc --noEmit -p apps/showcase/tsconfig.app.json",
    "verify": "node tools/scripts/verify.mjs"
  },
  "packageManager": "pnpm@10.33.2",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "less",
      "lmdb",
      "msgpackr-extract",
      "simple-git-hooks"
    ],
    "overrides": {
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "browserslist@<4.28.7": "4.28.7",
      "webpack-dev-server": "5.2.6",
      "webpack-dev-middleware@<7.4.6": "7.4.6",
      "body-parser@<1.20.6": "1.20.6",
      "svgo@<4.1.0": "4.1.0",
      "fast-uri@<3.1.8": "3.1.8",
      "hono@<4.13.7": "4.13.7",
      "@hono/node-server@<1.19.15": "1.19.15",
      "ip-address@<10.7.1": "10.7.1",
      "js-yaml@<3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "nanoid@<3.3.18": "3.3.18",
      "tar@<7.5.21": "7.5.22",
      "postcss@<8.5.18": "8.5.25",
      "qs@<6.16.0": "6.16.0",
      "undici@>=6.0.0 <6.28.1": "6.28.1",
      "undici@>=7.0.0 <7.29.1": "7.29.1",
      "piscina@<5.3.2": "5.3.2",
      "axios@<1.20.0": "1.20.0",
      "smol-toml@<1.9.0": "1.9.0",
      "colord@<2.9.4": "2.9.4",
      "proxy-addr@<2.0.8": "2.0.8",
      "shell-quote@<1.11.0": "1.11.0",
      "source-map-js@<1.2.2": "1.2.2",
      "compression@<1.8.2": "1.8.2",
      "uuid@<11.1.1": "11.1.1",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "http-cache-semantics@<4.3.0": "4.3.0",
      "@modelcontextprotocol/sdk@<1.31.0": "1.31.0",
      "read-yaml-file@1.1.0": "2.1.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit $1",
    "pre-push": "pnpm check:push"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,html,md}": [
      "prettier --write"
    ],
    "*.{scss,css}": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.2.19",
    "@angular-devkit/core": "~21.2.19",
    "@angular-devkit/schematics": "~21.2.19",
    "@angular/build": "~21.2.19",
    "@angular/cli": "~21.2.19",
    "@angular/compiler-cli": "~21.2.25",
    "@angular/language-service": "~21.2.25",
    "@angular/platform-browser-dynamic": "~21.2.25",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.8.0",
    "@fontsource/ibm-plex-serif": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@nx/angular": "^23.2.1",
    "@nx/devkit": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/playwright": "23.2.1",
    "@nx/storybook": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "~21.2.19",
    "@storybook/angular": "^10.1.0",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^26.1.0",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^21.2.0",
    "country-flag-icons": "^1.6.20",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "libphonenumber-js": "^1.13.11",
    "lint-staged": "^17.0.8",
    "ng-packagr": "~21.2.6",
    "nx": "23.2.1",
    "postcss": "^8.5.18",
    "prettier": "~3.6.2",
    "simple-git-hooks": "^2.13.1",
    "shiki": "^4.2.0",
    "storybook": "^10.1.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@angular/cdk": "~21.2.14",
    "@angular/common": "~21.2.25",
    "@angular/compiler": "~21.2.25",
    "@angular/core": "~21.2.25",
    "@angular/forms": "~21.2.25",
    "@angular/platform-browser": "~21.2.25",
    "@angular/router": "~21.2.25",
    "rxjs": "~7.8.0"
  }
