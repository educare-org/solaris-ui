{
  "name": "@solaris-ui/angular",
  "version": "0.3.0",
  "license": "MIT",
  "scripts": {
    "start": "node tools/scripts/check-workspace.mjs && node tools/scripts/check-package-manager.mjs && pnpm nx serve showcase --port=4300",
    "dev": "node tools/scripts/check-workspace.mjs && node tools/scripts/check-package-manager.mjs && pnpm nx serve showcase --port=4300",
    "showcase": "node tools/scripts/check-workspace.mjs && node tools/scripts/check-package-manager.mjs && pnpm nx serve showcase --port=4300",
    "build": "pnpm nx run-many -t build",
    "build:lib": "pnpm nx build angular && pnpm build:schematics",
    "build:schematics": "pnpm tsc -p packages/angular/tsconfig.schematics.json && node -e \"const fs=require('fs');fs.cpSync('packages/angular/schematics','dist/packages/angular/schematics',{recursive:true,filter:f=>{try{return fs.statSync(f).isDirectory()||f.endsWith('.json')}catch{return false}}})\"",
    "build:showcase": "pnpm nx build showcase",
    "test": "pnpm nx run-many -t test",
    "lint": "pnpm nx run-many -t lint",
    "format": "pnpm nx format:write",
    "format:check": "pnpm nx format:check",
    "graph": "pnpm nx graph",
    "doctor": "node tools/scripts/doctor.mjs",
    "check:workspace": "node tools/scripts/check-workspace.mjs",
    "check:package-manager": "node tools/scripts/check-package-manager.mjs",
    "check:scripts": "node tools/scripts/check-scripts.mjs",
    "check:architecture": "node tools/scripts/check-architecture.mjs",
    "check:docs": "node tools/scripts/check-docs.mjs",
    "check:tokens": "node tools/scripts/check-tokens.mjs",
    "check:i18n": "node tools/scripts/check-i18n.mjs",
    "check:security": "node tools/scripts/check-security.mjs",
    "check:dependencies": "node tools/scripts/check-dependencies.mjs",
    "package:check": "node tools/scripts/check-package.mjs",
    "prepare": "simple-git-hooks",
    "commitlint": "commitlint",
    "check:staged": "pnpm lint-staged",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status",
    "test:coverage": "pnpm nx run-many -t test:coverage",
    "check": "node tools/scripts/check-workspace.mjs && node tools/scripts/check-package-manager.mjs && node tools/scripts/check-scripts.mjs && node tools/scripts/check-architecture.mjs && node tools/scripts/check-docs.mjs && node tools/scripts/check-security.mjs && pnpm lint && pnpm typecheck",
    "typecheck": "pnpm tsc --noEmit -p packages/angular/tsconfig.lib.json && pnpm tsc --noEmit -p apps/showcase/tsconfig.app.json",
    "verify": "node tools/scripts/verify.mjs"
  },
  "packageManager": "pnpm@10.33.2",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "less",
      "lmdb",
      "msgpackr-extract",
      "simple-git-hooks"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit $1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,html,scss,css,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@angular-devkit/core": "~21.2.0",
    "@angular-devkit/schematics": "~21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/language-service": "~21.2.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.8.0",
    "@fontsource/ibm-plex-serif": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@nx/angular": "^23.0.1",
    "@nx/devkit": "23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/playwright": "23.0.1",
    "@nx/web": "23.0.1",
    "@nx/workspace": "23.0.1",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "~21.2.0",
    "@swc/helpers": "~0.5.18",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^21.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.0.8",
    "ng-packagr": "~21.2.0",
    "nx": "23.0.1",
    "postcss": "^8.4.5",
    "prettier": "~3.6.2",
    "simple-git-hooks": "^2.13.1",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@angular/cdk": "~21.2.14",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "rxjs": "~7.8.0"
  }
}
